--- /dev/null
+++ b/Sources/Farewell.swift
@@ -0,0 +1,15 @@
+import Foundation
+
+/// Added by the sample diff — the original does not exist on disk.
+struct Farewell {
+    let language: Greeter.Language
+
+    func message(for name: String) -> String {
+        switch language {
+        case .english: return "Bye, \(name)."
+        case .dutch: return "Doei, \(name)."
+        case .german: return "Tschüss, \(name)."
+        case .french: return "Au revoir, \(name)."
+        }
+    }
+}
